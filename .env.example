# ── Public site / Mono ──
NEXT_PUBLIC_GAS_URL=
NEXT_PUBLIC_SITE_URL=https://azhunebi.com
# Pause public + admin UI when true (API/cron stay up).
# Production: false or unset. Staging pause: true.
MAINTENANCE_MODE=false
# MAINTENANCE_MODE=true

# ── Supabase (Postgres) ──
NEXT_PUBLIC_SUPABASE_URL=
# Service role — server only (migrations). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional public Storage bucket for new room/logo uploads (default: media)
# SUPABASE_MEDIA_BUCKET=media
# Optional override for /api/migrate-db (defaults to CRON_SECRET)
# MIGRATE_SECRET=

# Data plane: gas (default, Sheets) | supabase (Postgres DAL)
DATA_SOURCE=supabase
# DATA_SOURCE=gas
# When DATA_SOURCE=gas, also upsert writes into Supabase (Phase 2 dual-write):
# DUAL_WRITE_SUPABASE=true
# When DATA_SOURCE=supabase, best-effort write-back to GAS (Phase 3):
# GAS_MIRROR_WRITES=true
# When DATA_SOURCE=gas, log Supabase count diffs on init (staging):
# SHADOW_COMPARE=true
# Bootstrap owner if settings.teamMembers missing (Supabase auth):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Online payment on the public site (Mono). Default OFF until set to true.
# NEXT_PUBLIC_ONLINE_PAYMENT_ENABLED=true
MONO_PUBLIC_ORIGIN=https://azhunebi.com
MONO_ACQUIRING_TOKEN=
# Покупка частинами (окремий продукт, не acquiring token):
MONO_CHAST_STORE_ID=
MONO_CHAST_SIGN_KEY=
# Optional override (default https://u2.monobank.com.ua):
# MONO_CHAST_API_URL=
# Never set in production (ignored unless MONO_ALLOW_TEST_AMOUNT=true):
# MONO_TEST_AMOUNT_UAH=1
# MONO_CHAST_TEST_AMOUNT_UAH=3
# MONO_ALLOW_TEST_AMOUNT=true

# ── SMS ──
TURBOSMS_TOKEN=
TURBOSMS_SENDER=
# TURBOSMS_ENABLED=false

# ── Telegram ──
# Local/staging: block all outbound Telegram API calls (mock ok + console.log)
# DISABLE_TELEGRAM_NOTIFS=true
# Production: leave unset / false so notifications go out.
DISABLE_TELEGRAM_NOTIFS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=-1003962488666
TELEGRAM_THREAD_BOOKINGS=5
TELEGRAM_THREAD_FINANCE=6
TELEGRAM_THREAD_ARRIVALS=7
TELEGRAM_THREAD_REQUESTS=8
TELEGRAM_THREAD_CHANGES=88
TELEGRAM_CHESSBOARD_URL=https://admin.azhunebi.com
TELEGRAM_CLEANING_CHAT_ID=-5577418097
# Prefer a dedicated random secret (NOT the bot token):
TELEGRAM_REVIEW_WEBHOOK_SECRET=
# Alphanumeric + _ - only (for Telegram setWebhook secret_token):
TELEGRAM_WEBHOOK_SECRET=

# ── Cron / lifecycle (cron-job.org → Authorization: Bearer <secret>) ──
# No Vercel Cron headers — every /api/internal/* job checks Bearer only.
CRON_SECRET=
TELEGRAM_CRON_SECRET=
PAYMENT_LIFECYCLE_SECRET=
# Prefer PAYMENT_LIFECYCLE_SECRET for payment-lifecycle; CRON_SECRET / TELEGRAM_CRON_SECRET also accepted.
# Telegram digests, iCal sync, keepalive: CRON_SECRET or TELEGRAM_CRON_SECRET.
# TELEGRAM_REVIEW_WEBHOOK_SECRET is for Telegram approve/reject webhooks (not cron).
